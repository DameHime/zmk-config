#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT  0
#define NUM_MODS 1
#define NUM_MOD 2
#define BT_CTRL  3

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp Q     &kp W     &kp E  &kp R  &kp T      &kp Y   &kp U  &kp I             &kp O                   &kp P               &kp BSPC
&kp TAB    &kp A     &kp S     &kp D  &kp F  &kp G      &kp H   &kp J  &kp K             &kp L                   &kp SEMI            &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C  &kp V  &kp B      &kp N   &kp M  &kp COMMA         &kp DOT                 &kp FSLH            &mt RIGHT_SHIFT KP_ENTER
&kp LCTRL  &kp LGUI  &kp LALT  &mo 2  &mo 1  &kp SPACE  &trans  &mo 1  &lt 2 LEFT_ARROW  &mt RIGHT_ALT UP_ARROW  &mt RIGHT_GUI DOWN  &mt RCTRL RIGHT
            >;
        };

        num_mods {
            bindings = <
&kp GRAVE     &kp N1         &kp N2        &kp N3     &kp N4         &kp N5      &kp N6  &kp N7  &kp N8          &kp N9            &kp N0      &kp DEL
&kp CAPSLOCK  &kp BACKSPACE  &kp UP_ARROW  &kp ENTER  &kp PAGE_UP    &kp HOME    &kp F1  &kp F2  &kp F3          &kp F4            &kp F5      &kp F6
&kp LSHFT     &kp LEFT       &kp DOWN      &kp RIGHT  &kp PAGE_DOWN  &kp INSERT  &kp F7  &kp F8  &kp F9          &kp F10           &kp F11     &kp F12
&kp LCTRL     &kp LGUI       &kp LALT      &mo 2      &to 0          &kp END     &trans  &mo 3   &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_STOP  &kp C_NEXT
            >;
        };

        num_mod {
            bindings = <
&kp ESC    &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp KP_NUMLOCK  &kp KP_N7  &kp KP_N8  &kp KP_N9  &kp KP_PLUS          &kp MINUS  &kp EQUAL  &kp BACKSPACE
&kp CAPS   &kp INSERT       &kp HOME        &kp PAGE_UP      &trans          &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_MINUS      &kp LBKT   &kp RBKT   &kp BSLH
&kp LSHFT  &kp DELETE       &kp END         &kp PAGE_DOWN    &trans          &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp LC(KP_EQUAL)  &kp HOME   &kp END    &kp ENTER
&kp LCTRL  &kp LGUI         &kp LALT        &sys_reset       &kp DELETE      &kp KP_N0  &trans     &mo 3      &kp LEFT          &kp RIGHT  &kp UP     &kp DOWN
            >;
        };

        bt_control {
            bindings = <
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &trans  &trans      &trans      &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans      &trans      &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans  &trans      &trans      &trans  &trans
&trans      &trans        &trans        &trans        &trans        &trans        &trans  &trans  &bt BT_PRV  &bt BT_NXT  &trans  &trans
            >;
        };
    };
};
