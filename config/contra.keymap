#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEFAULT  0
#define Fn_1	 1
#define Fn_2	 2
#define BT_CTRL  3
#define layer_4	 4

&mt { tapping-term-ms = <150>; };

/ {
    combos {
        compatible = "zmk,combos";

        vol_up {
            bindings = <&kp C_VOLUME_UP>;
            key-positions = <38 39>;
        };

        vol_down {
            bindings = <&kp C_VOLUME_DOWN>;
            key-positions = <38 40>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <11 10>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <22 23>;
        };
    };

    behaviors {
        test_behavior: test_behavior {
            compatible = "zmk,behavior-hold-tap";
            label = "TEST_BEHAVIOR";
            bindings = <&to>, <&mo>;

            #binding-cells = <2>;
            tapping-term-ms = <150>;
            hold-trigger-key-positions = <43>;
            hold-while-undecided;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Default Layer";
            bindings = <
&kp ESC    &kp Q     &kp W     &kp E  &kp R               &kp T      &kp Y   &kp U        &kp I             &kp O                     &kp P              &kp BSPC
&kp TAB    &kp A     &kp S     &kp D  &kp F               &kp G      &kp H   &kp J        &kp K             &kp L                     &kp SEMI           &kp SQT
&kp LSHFT  &kp Z     &kp X     &kp C  &kp V               &kp B      &kp N   &kp M        &kp COMMA         &kp DOT                   &kp FSLH           &mt RIGHT_SHIFT ENTER
&kp LCTRL  &kp LGUI  &kp LALT  &mo 2  &test_behavior 1 2  &kp SPACE  &trans  &lt 2 ENTER  &lt 1 LEFT_ARROW  &mt RIGHT_ALT DOWN_ARROW  &mt RGUI UP_ARROW  &mt RIGHT_CONTROL RIGHT_ARROW
            >;
        };

        Fn_1 {
            display-name = "Fn_1";
            bindings = <
&kp GRAVE     &kp N1          &kp N2          &kp N3           &kp N4  &kp N5         &kp N6  &kp N7  &kp N8  &kp N9   &kp N0   &kp DEL
&kp CAPSLOCK  &kp BACKSPACE   &kp UP_ARROW    &kp ENTER        &none   &kp PG_UP      &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6
&trans        &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &none   &kp PAGE_DOWN  &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
&trans        &trans          &trans          &trans           &to 0   &kp DEL        &trans  &mo 2   &none   &none    &none    &none
            >;
        };

        Fn_2 {
            bindings = <
&kp ESC  &kp PRINTSCREEN  &kp SCROLLLOCK  &kp PAUSE_BREAK  &kp KP_NUMLOCK  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS      &kp MINUS         &kp EQUAL          &kp BSPC
&kp TAB  &kp INS          &kp HOME        &kp PG_UP        &none           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS  &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
&trans   &kp DEL          &kp END         &kp PAGE_DOWN    &none           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &none         &none             &none              &kp RSHFT
&trans   &trans           &trans          &to 3            &to 0           &kp KP_NUMBER_0  &trans           &kp PERIOD       &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_STOP         &kp C_NEXT
            >;

            label = "Fn_2";
        };

        bt_control {
            display-name = "Bt Control";
            bindings = <
&bt BT_CLR      &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &none  &none  &none       &none       &none  &bootloader
&bt BT_CLR_ALL  &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4  &none  &none  &none       &none       &none  &none
&studio_unlock  &none          &none          &none          &none          &none          &none  &none  &none       &none       &none  &studio_unlock
&none           &none          &none          &none          &to 0          &none          &none  &none  &bt BT_PRV  &bt BT_NXT  &none  &none
            >;
        };

        layer_4 {
            bindings = <
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
